# Copy this file to .env and fill it in. Never commit .env.

# From @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Where finished requests are sent. Send /id to your bot to get your number.
# Multiple founders: separate with commas.
# IMPORTANT: each admin must press Start in the bot once, otherwise Telegram
# refuses to deliver messages to them.
ADMIN_CHAT_IDS=123456789

# Optional. Needed when running from inside Iran.
#   SOCKS5:  socks5://127.0.0.1:1080
#   HTTP:    http://127.0.0.1:8080
#   with auth: socks5://user:pass@127.0.0.1:1080
PROXY_URL=

# How updates are received.
#   polling — default. Local machine or a VPS. No public address needed.
#   webhook — hosted with a public HTTPS URL (Render sets this up automatically).
# Leave empty to auto-detect: webhook if a public URL is present, otherwise polling.
MODE=

# Only for webhook mode on a host that is not Render, e.g. https://bot.bizynex.com
# On Render this is filled in automatically from RENDER_EXTERNAL_URL.
WEBHOOK_URL=

# Optional overrides
# PORT=10000            # webhook mode only; Render sets this for you
# STARTUP_PING=1        # DM the admins when the bot starts (off by default on hosts)
# DB_PATH=data/leads.db
# STATE_PATH=data/state.pickle
# LOG_LEVEL=INFO
